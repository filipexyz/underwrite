# Copy to `.env.local` (Next.js and the pnpm scripts both read it; it is gitignored).
# Database / Auth0 / tracing are optional. Marketplace inference is not:
# without MODEL_PROVIDER_API_KEY, POST /api/v1/requests returns 503.
# Never put a real API key in git.

# ---------------------------------------------------------------------------
# Database — Neon (Postgres) is the system of record
# ---------------------------------------------------------------------------
# Neon connection string (the pooled `-pooler` host is fine — we use the HTTP driver).
# Leave empty to run on embedded PGlite at ./.data/pglite (auto-migrates, auto-seeds).
DATABASE_URL=

# ---------------------------------------------------------------------------
# Auth0 — human pages (/console, /keys, /account, /agents, /admin, /interviews, /claim)
# ---------------------------------------------------------------------------
# All four required; with any missing the proxy is a pass-through and human
# pages are open as user `local-dev`. Agent routes under /api/v1 never require
# an Auth0 cookie (they take a JWT, hashed key, or stay public).
# `/i/[token]` is public (invite token). `/auth.md` is public.
# Domain has no scheme: your-tenant.us.auth0.com
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# openssl rand -hex 32
AUTH0_SECRET=
# Local: http://localhost:3000  Alias: AUTH0_BASE_URL. Omit on Vercel Preview.
APP_BASE_URL=http://localhost:3000
# Set only after the Auth0 API (Resource Server) exists, or login breaks.
# AUTH0_AUDIENCE=https://api.underwrite
# HS256 for auth.md tokens. Falls back to AUTH0_SECRET, then a local stub.
# UNDERWRITE_TOKEN_SECRET=
# Optional bootstrap if the Post-Login Action / app_metadata is awkward.
# Primary admin check: app_metadata.role=admin → claim https://underwrite/roles
UNDERWRITE_ADMIN_USER_IDS=

# ---------------------------------------------------------------------------
# Agent-facing API
# ---------------------------------------------------------------------------
# Optional *legacy* global bearer for /api/v1/* (`Authorization: Bearer <key>`
# or `x-api-key`). Prefer hashed buyer keys minted at /keys. Unset + no
# presented key = public (demoday). `pnpm demo` sends this automatically when set.
# Interview APIs ignore this key (Auth0 session for creators; invite token for `/i`).
UNDERWRITE_API_KEY=

# ---------------------------------------------------------------------------
# Model provider — NeuraLake (OpenAI-compatible chat/completions)
# ---------------------------------------------------------------------------
# Required for the marketplace, console demo, playground, and `pnpm loop`.
# Unset API key → HTTP 503. There is no simulated-token fallback.
# Vercel: set these on the project (Production + Preview). Do not commit keys.
MODEL_PROVIDER_BASE_URL=https://api.neuralake.cloud/v1
MODEL_PROVIDER_API_KEY=
MODEL_PROVIDER_NAME=neuralake
# Optional override; default is auto (NeuraLake router).
MODEL_PROVIDER_MODEL=auto
# Also honoured as aliases: NEURALAKE_BASE_URL, NEURALAKE_API_KEY, OPENAI_API_KEY.

# ---------------------------------------------------------------------------
# Observability — Mastra tracing exporters (no-op when unset)
# ---------------------------------------------------------------------------
# Langfuse: both keys required to export workflow / model-call spans.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Print Mastra spans to stdout (1 = on).
MASTRA_OBSERVABILITY_CONSOLE=0
MASTRA_SERVICE_NAME=underwrite

# ---------------------------------------------------------------------------
# Demo pacing
# ---------------------------------------------------------------------------
# Real sleep (ms) between workflow hops so the console visibly streams on stage.
DEMO_STEP_DELAY_MS=0

# ---------------------------------------------------------------------------
# Interview pool — Agora + OpenAI GPT Live (optional)
# ---------------------------------------------------------------------------
# All three required to start a voice interview. Missing keys: `/interviews`
# shows setup instructions; POST /api/v1/interviews/needs/[id]/start returns 503.
# The marketplace is unaffected. GPT Live is an early-access preview (alpha).
NEXT_PUBLIC_AGORA_APP_ID=
# Server only. Alias: NEXT_AGORA_APP_CERTIFICATE (Agora CLI / recipe name).
AGORA_APP_CERTIFICATE=
# Prefer a dedicated key. Fallbacks: NEXT_OPENAI_API_KEY, OPENAI_API_KEY,
# MODEL_PROVIDER_API_KEY. GPT Live is not the same as the marketplace provider.
AGORA_OPENAI_API_KEY=
# Optional. Recipe default is gpt-live-1 (SDK 2.8.1). Some preview docs still
# mention gpt-live-1-diamond-alpha.
AGORA_GPT_LIVE_MODEL=gpt-live-1
AGORA_GPT_LIVE_VOICE=cedar
# US | EU | AP | CN
AGORA_AREA=US

# ---------------------------------------------------------------------------
# `pnpm demo` target (defaults to the local dev server)
# ---------------------------------------------------------------------------
UNDERWRITE_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Locked marketplace PoC (no reprice) — optional, off by default
# ---------------------------------------------------------------------------
# When 1, POST /api/v1/requests with no execution_mode uses the push path
# (hold → invite Top-K → one plan+price → best-score → lock → deliver).
# The console "Fire demo request" button and `pnpm demo` always send
# execution_mode: "seed" so the Mastra demoday loop is unchanged.
MARKETPLACE_PUSH=0
# Plan window (ms). Select when it elapses or every invitee has posted a plan.
PLAN_WINDOW_MS=8000
# How many hireable agents to invite (specialty match, prefer webhook_url).
MARKETPLACE_TOP_K=5
# HMAC secret for seller webhooks. Unset = documented stub `underwrite-webhook-stub`.
UNDERWRITE_WEBHOOK_SECRET=
