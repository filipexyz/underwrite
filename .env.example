# Copy to `.env.local` (Next.js and the pnpm scripts both read it; it is gitignored).
# Every variable is optional: with an empty file the loop runs end to end on
# embedded PGlite, with simulated inference, an open console and no tracing.

# ---------------------------------------------------------------------------
# Database — Neon (Postgres) is the system of record
# ---------------------------------------------------------------------------
# Neon connection string (the pooled `-pooler` host is fine — we use the HTTP driver).
# Leave empty to run on embedded PGlite at ./.data/pglite (auto-migrates, auto-seeds).
DATABASE_URL=

# ---------------------------------------------------------------------------
# Clerk — human pages (/console, /keys, /agents/register, /admin)
# ---------------------------------------------------------------------------
# Both keys required; with either missing the proxy is a pass-through and the
# human pages are open. Agent routes under /api/v1 never go through Clerk.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional bootstrap if setting Clerk public metadata is awkward.
# Primary admin check: Dashboard → Users → Public metadata { "role": "admin" }.
UNDERWRITE_ADMIN_USER_IDS=

# ---------------------------------------------------------------------------
# Agent-facing API
# ---------------------------------------------------------------------------
# Optional *legacy* global bearer for /api/v1/* (`Authorization: Bearer <key>`
# or `x-api-key`). Prefer hashed buyer keys minted at /keys. Unset + no
# presented key = public (demoday). `pnpm demo` sends this automatically when set.
UNDERWRITE_API_KEY=

# ---------------------------------------------------------------------------
# Model provider — any OpenAI-compatible endpoint (NeuraLake with model="auto")
# ---------------------------------------------------------------------------
# Both required for real inference. Unset = deterministic simulated inference:
# the ledger still carries per-call tokens, latency and dollars.
MODEL_PROVIDER_BASE_URL=
MODEL_PROVIDER_API_KEY=
MODEL_PROVIDER_NAME=neuralake
# Also honoured as aliases: NEURALAKE_BASE_URL, NEURALAKE_API_KEY, OPENAI_API_KEY.

# ---------------------------------------------------------------------------
# Observability — Mastra tracing exporters (no-op when unset)
# ---------------------------------------------------------------------------
# Langfuse: both keys required to export workflow / model-call spans.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Print Mastra spans to stdout (1 = on).
MASTRA_OBSERVABILITY_CONSOLE=0
MASTRA_SERVICE_NAME=underwrite

# ---------------------------------------------------------------------------
# Demo pacing
# ---------------------------------------------------------------------------
# Real sleep (ms) between workflow hops so the console visibly streams on stage.
# Simulated latency inside the loop is independent of this.
DEMO_STEP_DELAY_MS=0

# ---------------------------------------------------------------------------
# `pnpm demo` target (defaults to the local dev server)
# ---------------------------------------------------------------------------
UNDERWRITE_BASE_URL=http://localhost:3000
