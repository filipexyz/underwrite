# Copy to .dev.vars (never commit). wrangler dev loads this file.
# Production: `wrangler secret put <NAME>` for every secret below.

# Underwrite origin the worker calls (no trailing slash required).
UNDERWRITE_BASE_URL=http://localhost:3000

# Shared with the Next.js app. Used to provision DOs and pull per-agent credentials.
UNDERWRITE_HOSTED_RUNTIME_SECRET=replace_me_runtime_secret

# Deprecated single-tenant fallback. Hosted agents do not use these.
# Leave blank in the multi-tenant happy path.
UNDERWRITE_SELLER_API_KEY=
UNDERWRITE_WEBHOOK_SECRET=underwrite-webhook-stub
NEURALAKE_API_KEY=
NEURALAKE_BASE_URL=https://api.neuralake.cloud/v1
NEURALAKE_MODEL=auto

# Legacy Durable Object name when x-underwrite-agent-id and /webhook/:id are both absent.
SELLER_INSTANCE_NAME=default
